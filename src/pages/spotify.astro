---
import Layout from "../layouts/Layout.astro";
import { SITE_DOMAIN } from "../config/portfolioData";
---

<Layout title={`Spotify | ${SITE_DOMAIN}`} description="Spotify listening history, top tracks, artists, and stats.">
  <main class="about-page">
    <header class="about-header">
      <h1 class="about-title" transition:name="posts-title">Spotify</h1>
      <p class="about-desc" transition:name="posts-desc">My Spotify history, top tracks, artists & stats.</p>
    </header>

    <div class="about-page-container">
      <section class="about-section">
        <fieldset class="about-fieldset">
          <legend class="about-legend">Now Playing</legend>
          <div class="spotify-card">
            <p class="placeholder">No track playing or data unavailable.</p>
          </div>
        </fieldset>
      </section>

      <section class="about-section">
        <fieldset class="about-fieldset">
          <legend class="about-legend">Recent Tracks</legend>
          <div class="spotify-card">
            <p class="placeholder">Recent listening history coming soon.</p>
          </div>
        </fieldset>
      </section>

      <section class="about-section">
        <fieldset class="about-fieldset">
          <legend class="about-legend">Top Tracks</legend>
          <div class="spotify-card">
            <p class="placeholder">Top tracks will appear here.</p>
          </div>
        </fieldset>
      </section>

      <section class="about-section">
        <fieldset class="about-fieldset">
          <legend class="about-legend">Top Artists</legend>
          <div class="spotify-card">
            <p class="placeholder">Top artists will appear here.</p>
          </div>
        </fieldset>
      </section>

      <section class="about-section">
        <fieldset class="about-fieldset">
          <legend class="about-legend">Stats</legend>
          <div class="spotify-card">
            <p class="placeholder">Listening stats coming soon.</p>
          </div>
        </fieldset>
      </section>
    </div>
  </main>
</Layout>

<style>
  .about-page {
    max-width: 900px;
    margin: 0 auto;
    padding: 2rem 1.5rem 4rem;
  }

  .about-header {
    margin-bottom: 2rem;
  }

  .about-title {
    font-size: 2rem;
    font-weight: 700;
    margin: 0 0 0.5rem 0;
    color: var(--text-primary);
    font-family: var(--font-minecraft);
  }

  .about-desc {
    color: var(--text-secondary);
    margin: 0;
    font-size: 0.95rem;
  }

  .about-page-container {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .about-section {
    width: 100%;
  }

  .about-fieldset {
    border: 1px solid var(--card-border);
    border-radius: 12px;
    padding: 1.25rem;
    background: var(--card-bg);
  }

  .about-legend {
    color: var(--accent-color);
    font-family: var(--font-minecraft);
    font-size: 0.9rem;
    text-transform: uppercase;
    padding: 0 0.5rem;
  }

  .spotify-card {
    min-height: 120px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .placeholder {
    color: var(--text-muted);
    font-size: 0.9rem;
    text-align: center;
    margin: 0;
  }

  @media (max-width: 768px) {
    .about-page {
      padding: 1.5rem 1rem 3rem;
    }

    .about-fieldset {
      padding: 1rem;
    }

    .about-page-container {
      gap: 1rem;
    }
  }
</style>
