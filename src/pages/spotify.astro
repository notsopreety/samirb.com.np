---
import Layout from "../layouts/Layout.astro";
import { SITE_DOMAIN } from "../config/portfolioData";

let recent: any[] = [];
let topTracks: any[] = [];
let topArtists: any[] = [];
let topGenres: any[] = [];

try {
  const [rRes, tRes, aRes, gRes] = await Promise.all([
    fetch("https://api.samirbadaila.com.np/api/spotify/recent", { cache: "no-store" }),
    fetch("https://api.samirbadaila.com.np/api/spotify/top/tracks", { cache: "no-store" }),
    fetch("https://api.samirbadaila.com.np/api/spotify/top/artists", { cache: "no-store" }),
    fetch("https://api.samirbadaila.com.np/api/spotify/top/genres", { cache: "no-store" }),
  ]);
  if (rRes.ok) {
    const j = await rRes.json();
    recent = j.data?.streams || [];
  }
  if (tRes.ok) {
    const j = await tRes.json();
    topTracks = j.data?.tracks || [];
  }
  if (aRes.ok) {
    const j = await aRes.json();
    topArtists = j.data?.artists || [];
  }
  if (gRes.ok) {
    const j = await gRes.json();
    topGenres = j.data?.genres || [];
  }
} catch (e) {
  // ignore
}

function timeAgo(ts: string) {
  const diff = Date.now() - new Date(ts).getTime();
  const sec = Math.floor(diff / 1000);
  if (sec < 60) return `${sec}s ago`;
  const min = Math.floor(sec / 60);
  if (min < 60) return `${min}m ago`;
  const hr = Math.floor(min / 60);
  if (hr < 24) return `${hr}h ago`;
  const d = Math.floor(hr / 24);
  return `${d}d ago`;
}

function formatDuration(ms: number) {
  if (!ms) return "";
  const s = Math.floor(ms / 1000);
  const m = Math.floor(s / 60);
  const sec = s % 60;
  return `${m}:${sec.toString().padStart(2, "0")}`;
}
---

<Layout title={`Spotify | ${SITE_DOMAIN}`} description="Spotify listening history, top tracks, artists, and stats.">
  <div class="about-page-wrapper">
    <div class="breadcrumb" transition:name="posts-breadcrumb">
      <a href="/">Home</a>
      <span class="separator">&raquo;</span>
      <span>Spotify</span>
    </div>

    <header class="about-header">
      <h1 class="about-title" transition:name="posts-title">Spotify</h1>
      <p class="about-desc" transition:name="posts-desc">My Spotify listening history, top tracks, artists & stats.</p>
    </header>

    <div class="about-page-container">
      <section class="about-section">
        <fieldset class="about-fieldset">
          <legend class="about-legend">Recent Tracks</legend>
          {recent.length ? (
            <>
              <div class="track-list" data-list="recent">
                {recent.map((s: any, i: number) => {
                  const track = s.track || {};
                  const artists = (s.artists || []).map((a: any) => a.name).join(", ");
                  const img = track.image || "";
                  const href = track.spotifyUrl || "#";
                  return (
                    <a class={`track-item ${i >= 5 ? "hidden" : ""}`} href={href} target="_blank" rel="noopener noreferrer" data-index={i}>
                      <span class="track-num">{i + 1}</span>
                      <img class="track-art" src={img} alt={track.name} loading="lazy" />
                      <div class="track-info">
                        <div class="track-name">{track.name}</div>
                        <div class="track-artist">{artists}</div>
                      </div>
                      <div class="track-meta">
                        {track.duration && <span>{track.duration}</span>}
                        {s.playedAt && <span>{timeAgo(s.playedAt)}</span>}
                      </div>
                    </a>
                  );
                })}
              </div>
              {recent.length > 5 && <button class="show-more" data-target="recent"><span>Show more</span><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"></polyline></svg></button>}
            </>
          ) : (
            <div class="spotify-block">
              <p class="spotify-placeholder">No recent tracks.</p>
            </div>
          )}
        </fieldset>
      </section>

      <section class="about-section">
        <fieldset class="about-fieldset">
          <legend class="about-legend">Top Tracks (Last 4 Weeks)</legend>
          {topTracks.length ? (
            <>
              <div class="track-list" data-list="toptracks">
                {topTracks.map((t: any) => {
                  const track = t.track || t;
                  const artists = (t.artists || track.artists || []).map((a: any) => a.name || a).join(", ");
                  const img = track.image || t.image || "";
                  const href = track.spotifyUrl || t.spotifyUrl || "#";
                  const ind = t.indicator || "";
                  const idx = (t.position || 0) - 1;
                  return (
                    <a class={`track-item ${idx >= 5 ? "hidden" : ""}`} href={href} target="_blank" rel="noopener noreferrer" data-index={idx}>
                      <div class="track-rank">
                        <span class="track-num">{t.position || "-"}</span>
                        {ind === "UP" && <span class="rank-ind up">▲</span>}
                        {ind === "DOWN" && <span class="rank-ind down">▼</span>}
                        {ind === "NEW" && <span class="rank-ind new">NEW</span>}
                        {(ind === "SAME" || !ind) && <span class="rank-ind same">—</span>}
                      </div>
                      <img class="track-art" src={img} alt={track.name} loading="lazy" />
                      <div class="track-info">
                        <div class="track-name">{track.name}</div>
                        <div class="track-artist">{artists}</div>
                      </div>
                      <div class="track-meta">
                        {track.duration && <span>{track.duration}</span>}
                      </div>
                    </a>
                  );
                })}
              </div>
              {topTracks.length > 5 && <button class="show-more" data-target="toptracks"><span>Show more</span><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"></polyline></svg></button>}
            </>
          ) : (
            <div class="spotify-block">
              <p class="spotify-placeholder">No top tracks.</p>
            </div>
          )}
        </fieldset>
      </section>

      <section class="about-section">
        <fieldset class="about-fieldset">
          <legend class="about-legend">Top Artists (Last 4 Weeks)</legend>
          {topArtists.length ? (
            <>
              <div class="track-list" data-list="topartists">
                {topArtists.map((a: any, i: number) => {
                  const img = a.image || a.artist?.image || "";
                  const href = a.spotifyUrl || a.artist?.spotifyUrl || "#";
                  const pos = a.position || i + 1;
                  const ind = a.indicator || "";
                  const followers = a.followers ? new Intl.NumberFormat().format(a.followers) : "";
                  return (
                    <a class={`track-item ${i >= 5 ? "hidden" : ""}`} href={href} target="_blank" rel="noopener noreferrer" data-index={i}>
                      <div class="track-rank">
                        <span class="track-num">{pos}</span>
                        {ind === "UP" && <span class="rank-ind up">▲</span>}
                        {ind === "DOWN" && <span class="rank-ind down">▼</span>}
                        {ind === "NEW" && <span class="rank-ind new">NEW</span>}
                        {(ind === "SAME" || !ind) && <span class="rank-ind same">—</span>}
                      </div>
                      <img class="track-art" src={img} alt={a.name} loading="lazy" style="border-radius: 50%;" />
                      <div class="track-info">
                        <div class="track-name">{a.name || a.artist?.name}</div>
                        {followers && <div class="track-artist">{followers} followers</div>}
                      </div>
                      <div class="track-meta">
                        {a.popularity !== undefined && <span>Popularity {a.popularity}</span>}
                      </div>
                    </a>
                  );
                })}
              </div>
              {topArtists.length > 5 && <button class="show-more" data-target="topartists"><span>Show more</span><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"></polyline></svg></button>}
            </>
          ) : (
            <div class="spotify-block">
              <p class="spotify-placeholder">No top artists.</p>
            </div>
          )}
        </fieldset>
      </section>

      <section class="about-section">
        <fieldset class="about-fieldset">
          <legend class="about-legend">Top Genres (Last 4 Weeks)</legend>
          {topGenres.length ? (
            <>
              <div class="tags-list" data-list="topgenres">
                {topGenres.map((g: any, i: number) => (
                  <div class={`tag-item ${i >= 5 ? "hidden" : ""}`} data-index={i}>
                    <span class="tag-name">{g.name || g.genre}</span>
                    <span class="tag-count">#{g.position}</span>
                  </div>
                ))}
              </div>
              {topGenres.length > 5 && <button class="show-more" data-target="topgenres"><span>Show more</span><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"></polyline></svg></button>}
            </>
          ) : (
            <div class="spotify-block">
              <p class="spotify-placeholder">No top genres.</p>
            </div>
          )}
        </fieldset>
      </section>
    </div>
  </div>
</Layout>

<style>
  .about-page-wrapper {
    width: 100%;
  }

  .about-header {
    margin-bottom: 2rem;
  }

  .about-title {
    font-size: 2rem;
    font-weight: 700;
    margin: 0 0 0.5rem 0;
    color: var(--text-primary);
    font-family: var(--font-minecraft);
  }

  .about-desc {
    color: var(--text-secondary);
    margin: 0;
    font-size: 0.95rem;
  }

  .about-page-container {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .about-section {
    width: 100%;
  }

  .about-fieldset {
    border: 1px solid var(--card-border);
    border-radius: 12px;
    padding: 1.25rem;
    background: var(--card-bg);
  }

  .about-legend {
    color: var(--accent-color);
    font-family: var(--font-minecraft);
    font-size: 0.9rem;
    text-transform: uppercase;
    padding: 0 0.5rem;
  }

  .spotify-block {
    min-height: 120px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .spotify-placeholder {
    color: var(--text-muted);
    font-size: 0.9rem;
    text-align: center;
    margin: 0;
  }

  .track-list {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .track-item {
    display: grid;
    grid-template-columns: 38px 48px 1fr auto;
    gap: 0.75rem;
    align-items: center;
    padding: 0.5rem 0.6rem;
    border-radius: 10px;
    text-decoration: none;
    color: inherit;
    transition: background 0.15s ease;
  }

  .track-item:hover {
    background: color-mix(in srgb, var(--accent-color) 6%, transparent);
  }

  .track-rank {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.15rem;
  }

  .track-num {
    text-align: center;
    color: var(--text-muted);
    font-size: 0.85rem;
  }

  .rank-ind {
    font-size: 0.7rem;
    line-height: 1;
  }

  .rank-ind.up {
    color: #22c55e;
  }

  .rank-ind.down {
    color: #ef4444;
  }

  .rank-ind.new {
    color: var(--accent-color);
    font-size: 0.65rem;
  }

  .rank-ind.same {
    color: var(--text-muted);
  }

  .track-art {
    width: 48px;
    height: 48px;
    border-radius: 8px;
    object-fit: cover;
    background: var(--bg-color);
  }

  .track-info {
    min-width: 0;
  }

  .track-name {
    font-weight: 600;
    color: var(--text-primary);
    font-size: 0.9rem;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .track-artist {
    color: var(--text-secondary);
    font-size: 0.82rem;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .track-meta {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.2rem;
    color: var(--text-muted);
    font-size: 0.8rem;
  }

  .artist-lb-item {
    display: none;
  }

  .tags-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .tag-item {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.4rem 0.7rem;
    border-radius: 999px;
    border: 1px solid var(--card-border);
    background: var(--card-bg);
    text-decoration: none;
    color: var(--text-primary);
    font-size: 0.88rem;
  }

  .tag-item:hover {
    border-color: var(--accent-color);
  }

  .tag-name {
    text-transform: capitalize;
  }

  .tag-count {
    color: var(--text-muted);
    font-size: 0.8rem;
  }

  .hidden {
    display: none !important;
  }

  .show-more {
    margin: 0.6rem auto 0;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
    background: transparent;
    border: none;
    color: var(--accent-color);
    font-size: 0.88rem;
    cursor: pointer;
    padding: 0.3rem 0;
    width: fit-content;
  }

  .show-more:hover {
    text-decoration: underline;
  }

  @media (max-width: 768px) {
    .about-header {
      margin-bottom: 1.5rem;
    }

    .about-title {
      font-size: 1.75rem;
    }

    .about-desc {
      font-size: 0.9rem;
    }

    .about-fieldset {
      padding: 1rem;
    }

    .about-page-container {
      gap: 1rem;
    }

    .track-item {
      grid-template-columns: 32px 44px 1fr;
      gap: 0.6rem;
    }

    .track-meta {
      grid-column: 1 / -1;
      flex-direction: row;
      justify-content: space-between;
      padding-left: 92px;
    }

    .track-item {
      grid-template-columns: 32px 44px 1fr;
      gap: 0.6rem;
    }
  }

  @media (max-width: 480px) {
    .about-fieldset {
      padding: 0.875rem;
    }

    .about-legend {
      font-size: 0.85rem;
    }
  }
</style>

<script>
  function initShowMore() {
    document.querySelectorAll('.show-more').forEach((btn) => {
      btn.onclick = () => {
        const target = btn.getAttribute('data-target');
        if (!target) return;
        const list = document.querySelector(`.track-list[data-list="${target}"], .tags-list[data-list="${target}"]`);
        if (!list) return;
        const hidden = list.querySelectorAll('.hidden');
        if (hidden.length) {
          hidden.forEach((el) => el.classList.remove('hidden'));
          btn.innerHTML = '<span>Show less</span><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="18 15 12 9 6 15"></polyline></svg>';
        } else {
          list.querySelectorAll('[data-index]').forEach((el) => {
            const idx = parseInt(el.getAttribute('data-index') || '0');
            if (idx >= 5) el.classList.add('hidden');
          });
          btn.innerHTML = '<span>Show more</span><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"></polyline></svg>';
          try { list.scrollIntoView({ behavior: 'smooth', block: 'nearest' }); } catch {}
        }
      };
    });
  }
  document.addEventListener('astro:page-load', initShowMore);
  initShowMore();
</script>

