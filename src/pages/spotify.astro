---
import Layout from "../layouts/Layout.astro";
import { SITE_DOMAIN } from "../config/portfolioData";
---


<Layout title={`Spotify | ${SITE_DOMAIN}`} description="Spotify listening history, top tracks, artists, and stats.">
  <div class="about-page-wrapper">
    <div class="breadcrumb" transition:name="posts-breadcrumb">
      <a href="/">Home</a>
      <span class="separator">&raquo;</span>
      <span>Spotify</span>
    </div>

    <header class="about-header">
      <h1 class="about-title" transition:name="posts-title">Spotify</h1>
      <p class="about-desc" transition:name="posts-desc">My Spotify listening history, top tracks, artists & stats.</p>
    </header>

    <div class="about-page-container">
      <section class="about-section">
        <fieldset class="about-fieldset">
          <legend class="about-legend">Recent Tracks</legend>
          <div id="recent-list" class="track-list" data-list="recent"></div>
          <div id="recent-empty" class="spotify-block">
            <p class="spotify-placeholder">Loading...</p>
          </div>
          <button id="btn-recent" class="show-more" data-target="recent" style="display:none"><span>Show more</span><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"></polyline></svg></button>
        </fieldset>
      </section>

      <section class="about-section">
        <fieldset class="about-fieldset">
          <legend class="about-legend">Top Tracks (Last 4 Weeks)</legend>
          <div id="toptracks-list" class="track-list" data-list="toptracks"></div>
          <div id="toptracks-empty" class="spotify-block">
            <p class="spotify-placeholder">Loading...</p>
          </div>
          <button id="btn-toptracks" class="show-more" data-target="toptracks" style="display:none"><span>Show more</span><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"></polyline></svg></button>
        </fieldset>
      </section>

      <section class="about-section">
        <fieldset class="about-fieldset">
          <legend class="about-legend">Top Artists (Last 4 Weeks)</legend>
          <div id="topartists-list" class="track-list" data-list="topartists"></div>
          <div id="topartists-empty" class="spotify-block">
            <p class="spotify-placeholder">Loading...</p>
          </div>
          <button id="btn-topartists" class="show-more" data-target="topartists" style="display:none"><span>Show more</span><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"></polyline></svg></button>
        </fieldset>
      </section>

      <section class="about-section">
        <fieldset class="about-fieldset">
          <legend class="about-legend">Top Genres (Last 4 Weeks)</legend>
          <div id="topgenres-list" class="tags-list" data-list="topgenres"></div>
          <div id="topgenres-empty" class="spotify-block">
            <p class="spotify-placeholder">Loading...</p>
          </div>
          <button id="btn-topgenres" class="show-more" data-target="topgenres" style="display:none"><span>Show more</span><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"></polyline></svg></button>
        </fieldset>
      </section>
    </div>
  </div>
</Layout>

<style>
  .about-page-wrapper {
    width: 100%;
  }

  .about-header {
    margin-bottom: 2rem;
  }

  .about-title {
    font-size: 2rem;
    font-weight: 700;
    margin: 0 0 0.5rem 0;
    color: var(--text-primary);
    font-family: var(--font-minecraft);
  }

  .about-desc {
    color: var(--text-secondary);
    margin: 0;
    font-size: 0.95rem;
  }

  .about-page-container {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .about-section {
    width: 100%;
  }

  .about-fieldset {
    border: 1px solid var(--card-border);
    border-radius: 12px;
    padding: 1.25rem;
    background: var(--card-bg);
  }

  .about-legend {
    color: var(--accent-color);
    font-family: var(--font-minecraft);
    font-size: 0.9rem;
    text-transform: uppercase;
    padding: 0 0.5rem;
  }

  .spotify-block {
    min-height: 120px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .spotify-placeholder {
    color: var(--text-muted);
    font-size: 0.9rem;
    text-align: center;
    margin: 0;
  }

  .track-list {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .track-item {
    display: grid;
    grid-template-columns: 38px 48px 1fr auto;
    gap: 0.75rem;
    align-items: center;
    padding: 0.5rem 0.6rem;
    border-radius: 10px;
    text-decoration: none;
    color: inherit;
    transition: background 0.15s ease;
  }

  .track-item:hover {
    background: color-mix(in srgb, var(--accent-color) 6%, transparent);
  }

  .track-rank {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.15rem;
  }

  .track-num {
    text-align: center;
    color: var(--text-muted);
    font-size: 0.85rem;
  }

  .rank-ind {
    font-size: 0.7rem;
    line-height: 1;
  }

  .rank-ind.up {
    color: #22c55e;
  }

  .rank-ind.down {
    color: #ef4444;
  }

  .rank-ind.new {
    color: var(--accent-color);
    font-size: 0.65rem;
  }

  .rank-ind.same {
    color: var(--text-muted);
  }

  .track-art {
    width: 48px;
    height: 48px;
    border-radius: 8px;
    object-fit: cover;
    background: var(--bg-color);
  }

  .track-info {
    min-width: 0;
  }

  .track-name {
    font-weight: 600;
    color: var(--text-primary);
    font-size: 0.9rem;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .track-artist {
    color: var(--text-secondary);
    font-size: 0.82rem;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .track-meta {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.2rem;
    color: var(--text-muted);
    font-size: 0.8rem;
  }

  .artist-lb-item {
    display: none;
  }

  .tags-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .tag-item {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.4rem 0.7rem;
    border-radius: 999px;
    border: 1px solid var(--card-border);
    background: var(--card-bg);
    text-decoration: none;
    color: var(--text-primary);
    font-size: 0.88rem;
  }

  .tag-item:hover {
    border-color: var(--accent-color);
  }

  .tag-name {
    text-transform: capitalize;
  }

  .tag-count {
    color: var(--text-muted);
    font-size: 0.8rem;
  }

  .hidden {
    display: none !important;
  }

  .show-more {
    margin: 0.6rem auto 0;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
    background: transparent;
    border: none;
    color: var(--accent-color);
    font-size: 0.88rem;
    cursor: pointer;
    padding: 0.3rem 0;
    width: fit-content;
  }

  .show-more:hover {
    text-decoration: underline;
  }

  @media (max-width: 768px) {
    .about-header {
      margin-bottom: 1.5rem;
    }

    .about-title {
      font-size: 1.75rem;
    }

    .about-desc {
      font-size: 0.9rem;
    }

    .about-fieldset {
      padding: 1rem;
    }

    .about-page-container {
      gap: 1rem;
    }

    .track-item {
      grid-template-columns: 32px 44px 1fr;
      gap: 0.6rem;
    }

    .track-meta {
      grid-column: 1 / -1;
      flex-direction: row;
      justify-content: space-between;
      padding-left: 92px;
    }

    .track-item {
      grid-template-columns: 32px 44px 1fr;
      gap: 0.6rem;
    }
  }

  @media (max-width: 480px) {
    .about-fieldset {
      padding: 0.875rem;
    }

    .about-legend {
      font-size: 0.85rem;
    }
  }
</style>

<script>
  function timeAgo(ts: string) {
    const diff = Date.now() - new Date(ts).getTime();
    const sec = Math.floor(diff / 1000);
    if (sec < 60) return `${sec}s ago`;
    const min = Math.floor(sec / 60);
    if (min < 60) return `${min}m ago`;
    const hr = Math.floor(min / 60);
    if (hr < 24) return `${hr}h ago`;
    const d = Math.floor(hr / 24);
    return `${d}d ago`;
  }

  function formatDuration(ms: number) {
    if (!ms) return "";
    const s = Math.floor(ms / 1000);
    const m = Math.floor(s / 60);
    const sec = s % 60;
    return `${m}:${sec.toString().padStart(2, "0")}`;
  }

  function initShowMore() {
    document.querySelectorAll('.show-more').forEach((btn) => {
      btn.onclick = () => {
        const target = btn.getAttribute('data-target');
        if (!target) return;
        const list = document.querySelector(`.track-list[data-list="${target}"], .tags-list[data-list="${target}"]`);
        if (!list) return;
        const hidden = list.querySelectorAll('.hidden');
        if (hidden.length) {
          hidden.forEach((el) => el.classList.remove('hidden'));
          btn.innerHTML = '<span>Show less</span><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="18 15 12 9 6 15"></polyline></svg>';
        } else {
          list.querySelectorAll('[data-index]').forEach((el) => {
            const idx = parseInt(el.getAttribute('data-index') || '0');
            if (idx >= 5) el.classList.add('hidden');
          });
          btn.innerHTML = '<span>Show more</span><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"></polyline></svg>';
          try { list.scrollIntoView({ behavior: 'smooth', block: 'nearest' }); } catch {}
        }
      };
    });
  }

  async function loadSpotify() {
    try {
      const [rRes, tRes, aRes, gRes] = await Promise.all([
        fetch("https://api.samirbadaila.com.np/api/spotify/recent", { cache: "no-store" }),
        fetch("https://api.samirbadaila.com.np/api/spotify/top/tracks", { cache: "no-store" }),
        fetch("https://api.samirbadaila.com.np/api/spotify/top/artists", { cache: "no-store" }),
        fetch("https://api.samirbadaila.com.np/api/spotify/top/genres", { cache: "no-store" }),
      ]);

      const recent = rRes.ok ? (await rRes.json()).data?.streams || [] : [];
      const topTracks = tRes.ok ? (await tRes.json()).data?.tracks || [] : [];
      const topArtists = aRes.ok ? (await aRes.json()).data?.artists || [] : [];
      const topGenres = gRes.ok ? (await gRes.json()).data?.genres || [] : [];

      const recentList = document.getElementById('recent-list');
      const recentEmpty = document.getElementById('recent-empty');
      const btnRecent = document.getElementById('btn-recent');
      if (recentList && recentEmpty) {
        if (recent.length) {
          recentEmpty.style.display = 'none';
          recentList.innerHTML = '';
          recent.forEach((s: any, i: number) => {
            const track = s.track || {};
            const artists = (s.artists || []).map((a: any) => a.name).join(", ");
            const img = track.image || "";
            const href = track.spotifyUrl || "#";
            const a = document.createElement('a');
            a.className = `track-item ${i >= 5 ? "hidden" : ""}`;
            a.href = href;
            a.target = "_blank";
            a.rel = "noopener noreferrer";
            a.setAttribute('data-index', String(i));
            a.innerHTML = `<span class="track-num">${i + 1}</span><img class="track-art" src="${img}" alt="${(track.name||'').replace(/"/g,'&quot;')}" loading="lazy" /><div class="track-info"><div class="track-name">${track.name||''}</div><div class="track-artist">${artists}</div></div><div class="track-meta">${track.duration ? `<span>${track.duration}</span>` : ''}${s.playedAt ? `<span>${timeAgo(s.playedAt)}</span>` : ''}</div>`;
            recentList.appendChild(a);
          });
          if (recent.length > 5 && btnRecent) {
            btnRecent.style.display = 'flex';
          }
        } else {
          recentEmpty.querySelector('.spotify-placeholder').textContent = 'No recent tracks.';
        }
      }

      const ttList = document.getElementById('toptracks-list');
      const ttEmpty = document.getElementById('toptracks-empty');
      const btnTT = document.getElementById('btn-toptracks');
      if (ttList && ttEmpty) {
        if (topTracks.length) {
          ttEmpty.style.display = 'none';
          ttList.innerHTML = '';
          topTracks.forEach((t: any) => {
            const track = t.track || t;
            const artists = (t.artists || track.artists || []).map((a: any) => a.name || a).join(", ");
            const img = track.image || t.image || "";
            const href = track.spotifyUrl || t.spotifyUrl || "#";
            const ind = t.indicator || "";
            const idx = (t.position || 0) - 1;
            const a = document.createElement('a');
            a.className = `track-item ${idx >= 5 ? "hidden" : ""}`;
            a.href = href;
            a.target = "_blank";
            a.rel = "noopener noreferrer";
            a.setAttribute('data-index', String(idx));
            let indHtml = '';
            if (ind === "UP") indHtml = '<span class="rank-ind up">▲</span>';
            else if (ind === "DOWN") indHtml = '<span class="rank-ind down">▼</span>';
            else if (ind === "NEW") indHtml = '<span class="rank-ind new">NEW</span>';
            else indHtml = '<span class="rank-ind same">—</span>';
            a.innerHTML = `<div class="track-rank"><span class="track-num">${t.position||'-'}</span>${indHtml}</div><img class="track-art" src="${img}" alt="${(track.name||'').replace(/"/g,'&quot;')}" loading="lazy" /><div class="track-info"><div class="track-name">${track.name||''}</div><div class="track-artist">${artists}</div></div><div class="track-meta">${track.duration ? `<span>${track.duration}</span>` : ''}</div>`;
            ttList.appendChild(a);
          });
          if (topTracks.length > 5 && btnTT) btnTT.style.display = 'flex';
        } else {
          ttEmpty.querySelector('.spotify-placeholder').textContent = 'No top tracks.';
        }
      }

      const taList = document.getElementById('topartists-list');
      const taEmpty = document.getElementById('topartists-empty');
      const btnTA = document.getElementById('btn-topartists');
      if (taList && taEmpty) {
        if (topArtists.length) {
          taEmpty.style.display = 'none';
          taList.innerHTML = '';
          topArtists.forEach((a: any, i: number) => {
            const img = a.image || a.artist?.image || "";
            const href = a.spotifyUrl || a.artist?.spotifyUrl || "#";
            const pos = a.position || i + 1;
            const ind = a.indicator || "";
            const followers = a.followers ? new Intl.NumberFormat().format(a.followers) : "";
            const link = document.createElement('a');
            link.className = `track-item ${i >= 5 ? "hidden" : ""}`;
            link.href = href;
            link.target = "_blank";
            link.rel = "noopener noreferrer";
            link.setAttribute('data-index', String(i));
            let indHtml = '';
            if (ind === "UP") indHtml = '<span class="rank-ind up">▲</span>';
            else if (ind === "DOWN") indHtml = '<span class="rank-ind down">▼</span>';
            else if (ind === "NEW") indHtml = '<span class="rank-ind new">NEW</span>';
            else indHtml = '<span class="rank-ind same">—</span>';
            link.innerHTML = `<div class="track-rank"><span class="track-num">${pos}</span>${indHtml}</div><img class="track-art" src="${img}" alt="${(a.name||a.artist?.name||'').replace(/"/g,'&quot;')}" loading="lazy" style="border-radius: 50%;" /><div class="track-info"><div class="track-name">${a.name||a.artist?.name||''}</div>${followers ? `<div class="track-artist">${followers} followers</div>` : ''}</div><div class="track-meta">${a.popularity !== undefined ? `<span>Popularity ${a.popularity}</span>` : ''}</div>`;
            taList.appendChild(link);
          });
          if (topArtists.length > 5 && btnTA) btnTA.style.display = 'flex';
        } else {
          taEmpty.querySelector('.spotify-placeholder').textContent = 'No top artists.';
        }
      }

      const tgList = document.getElementById('topgenres-list');
      const tgEmpty = document.getElementById('topgenres-empty');
      const btnTG = document.getElementById('btn-topgenres');
      if (tgList && tgEmpty) {
        if (topGenres.length) {
          tgEmpty.style.display = 'none';
          tgList.innerHTML = '';
          topGenres.forEach((g: any, i: number) => {
            const div = document.createElement('div');
            div.className = `tag-item ${i >= 5 ? "hidden" : ""}`;
            div.setAttribute('data-index', String(i));
            div.innerHTML = `<span class="tag-name">${g.name||g.genre||''}</span><span class="tag-count">#${g.position||i+1}</span>`;
            tgList.appendChild(div);
          });
          if (topGenres.length > 5 && btnTG) btnTG.style.display = 'flex';
        } else {
          tgEmpty.querySelector('.spotify-placeholder').textContent = 'No top genres.';
        }
      }

      initShowMore();
    } catch (e) {
      const placeholders = document.querySelectorAll('.spotify-placeholder');
      placeholders.forEach((p) => { if (p.textContent === 'Loading...') p.textContent = 'Failed to load.'; });
    }
  }

  document.addEventListener('astro:page-load', () => { initShowMore(); loadSpotify(); });
  initShowMore();
  loadSpotify();
</script>

